{
  "name": "submerge-proposal-builder",
  "version": "3.2.5",
  "description": "Submerge Proposal Builder",
  "main": "main.js",
  "scripts": {
    "dev": "node dev-start.js",
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "check:dead-exports": "npx --yes ts-prune",
    "generate:feenstra-may-engine": "node scripts/generate-feenstra-may-2026-engine.js",
    "generate:feenstra-may-pricing": "node scripts/generate-feenstra-may-2026-pricing-snapshot.js",
    "verify:feenstra-legacy-pricing": "node scripts/verify-feenstra-legacy-pricing.js",
    "verify:multi-franchise": "node scripts/verify-multi-franchise-foundation.js",
    "verify:dashboard-load": "node scripts/verify-dashboard-load-safety.js",
    "verify:proposal-version-copy": "node scripts/verify-proposal-version-copy.js",
    "verify:proposal-persistence-safety": "esbuild scripts/verify-proposal-persistence-safety.ts --bundle --platform=node --format=esm --outfile=test-results/verify-proposal-persistence-safety.mjs && node test-results/verify-proposal-persistence-safety.mjs",
    "verify:custom-option-pricing": "esbuild scripts/verify-custom-option-pricing.ts --bundle --platform=node --format=esm --outfile=test-results/verify-custom-option-pricing.mjs && node test-results/verify-custom-option-pricing.mjs",
    "verify:cogs-overhead-pricing": "esbuild scripts/verify-cogs-overhead-pricing.ts --bundle --platform=node --format=esm --outfile=test-results/verify-cogs-overhead-pricing.mjs && node test-results/verify-cogs-overhead-pricing.mjs",
    "verify:proposal-savings": "esbuild scripts/verify-proposal-savings.ts --bundle --platform=node --format=esm --outfile=test-results/verify-proposal-savings.mjs && node test-results/verify-proposal-savings.mjs",
    "verify:price-impact": "esbuild scripts/verify-price-impact.ts --bundle --platform=node --format=esm --outfile=test-results/verify-price-impact.mjs && node test-results/verify-price-impact.mjs",
    "verify:cloud-reachability": "esbuild scripts/verify-supabase-reachability.ts --bundle --platform=node --format=esm --outfile=test-results/verify-supabase-reachability.mjs && node test-results/verify-supabase-reachability.mjs",
    "test:ui": "vite build --mode test && playwright test",
    "test:electron-ui": "vite build --mode test && cross-env SUBMERGE_ELECTRON_UI_ONLY=1 playwright test tests/e2e/electron-smoke.spec.ts tests/e2e/proposal-persistence-safety.spec.ts",
    "test:ui:headed": "vite build --mode test && playwright test --headed",
    "test:ui:open": "vite build --mode test && playwright test --ui",
    "test:ui:report": "playwright show-report",
    "test:ui:install": "playwright install chromium",
    "supabase:login": "supabase login",
    "supabase:functions:staging": "node scripts/deploy-edge-functions-staging.js",
    "supabase:functions:production": "node scripts/deploy-edge-functions-production.js",
    "test:electron": "cross-env NODE_ENV=production npx electron .",
    "build": "tsc && vite build && electron-builder",
    "build:win": "npm run build -- --win",
    "build:installer": "vite build && electron-builder --win nsis --publish never",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "pool",
    "proposal",
    "design"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.2",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.6.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "png-to-ico": "^3.0.1",
    "supabase": "2.109.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.submerge.proposalbuilder",
    "productName": "Submerge Proposal Builder",
    "artifactName": "${productName} v${version}-${arch}.${ext}",
    "afterSign": "scripts/notarize.js",
    "publish": [
      {
        "provider": "github",
        "owner": "muphy09",
        "repo": "Submerge-App",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "portable builds"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "CHANGELOG.md",
      "release-notes/**/*",
      "preload-script.js",
      "src/database/**/*",
      "icon.ico",
      "*.png",
      "package.json",
      "!**/*.ts",
      "!*.ts"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "submerge",
        "name": "Submerge Proposal File",
        "description": "Submerge Pool Proposal",
        "icon": "icon.png",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
